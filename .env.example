# =====================================================================================================
# Vórtex CRM · modelo das variáveis de ambiente
# Nunca coloque valores reais neste arquivo: ele vai para o GitHub. Os valores reais ficam em:
#   - BLOCO 1 (painel)   → arquivo .env.local (no seu computador) e Vercel → Settings → Environment Variables
#   - BLOCO 2 (servidor) → arquivo supabase/functions/.env e depois `npx supabase secrets set --env-file supabase/functions/.env`
# Os dois arquivos já estão no .gitignore. Apague as linhas que ficarem vazias antes de enviar os segredos.
# =====================================================================================================

# ---------- BLOCO 1 · PAINEL (Vite) ----------
# Endereço do seu projeto no Supabase (Project Settings → API → Project URL). Obrigatória.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" do Supabase (Project Settings → API Keys → aba Legacy → anon). Obrigatória.
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# Domínio público do painel, usado nos links do rotacionador (/r/...). Opcional: sem ela, vale o endereço aberto no navegador.
VITE_SITE_URL=https://seu-dominio.com.br
# Tutoriais prontos do Grupo Vórtex na aba Tutoriais. Opcional: deixe vazio para mostrar; off para esconder.
VITE_TUTORIAIS_PADRAO=
# Senha do banco do Supabase (a que você criou junto com o projeto). Só no .env.local do seu computador: a CLI do
# Supabase usa no `link` e no `db push`. NÃO cadastre na Vercel.
SUPABASE_DB_PASSWORD=

# ---------- BLOCO 2 · SERVIDOR (segredos das Edge Functions do Supabase) ----------
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o próprio Supabase entrega às funções: não precisa cadastrar.

# Domínio do painel (o mesmo da Vercel). Usado no rotacionador e na volta do login do Instagram. Obrigatória.
SITE_URL=https://seu-dominio.com.br
# Outros endereços do painel aceitos na volta do login do Instagram (ex.: uma prévia da Vercel), separados por vírgula. Opcional.
APP_ORIGINS=

# WhatsApp por QR Code (Zapbot): login da sua conta no Zapbot. Obrigatórias para conectar por QR Code.
ZAPBOT_EMAIL=voce@exemplo.com
ZAPBOT_PASSWORD=sua-senha-do-zapbot
# Endereço da API do Zapbot. Opcional (padrão: https://api.zapbot.online).
ZAPBOT_API_URL=

# WhatsApp oficial (Meta, "Entrar com o Facebook"). Só se for usar a API Oficial.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Texto aleatório que você inventa e repete na configuração do webhook do app na Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Versão da Graph API. Opcional (padrão: v26.0).
META_GRAPH_VERSION=

# IA da plataforma (opcional): chave usada pelas empresas SEM chave própria e com a carteira de IA ativa (Créditos de IA).
# Para começar, prefira colar a chave da IA no painel, em Configurações → Integrações.
# Provedor: openai, gemini ou compat.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Só quando AI_PROVIDER=compat (Groq, DeepSeek, OpenRouter...): endereço base da API.
AI_BASE_URL=
# Voz e transcrição pela ElevenLabs para a plataforma (opcional; cada empresa também pode ter a dela em Integrações).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Modelos do Vórtex Inteligência (opcional; sem eles, usa o modelo da plataforma).
INTEL_MODELO=
INTEL_MODELO_LEVE=

# Instagram (Direct) pela Zernio (opcional). A chave da plataforma; cada empresa também pode conectar com a chave dela.
ZERNIO_API_KEY=
# Segredo que você cadastra no webhook da Zernio (o mesmo valor nos dois lugares).
ZERNIO_WEBHOOK_SECRET=
# Endereço da API da Zernio. Opcional (padrão: https://zernio.com/api/v1).
ZERNIO_API_URL=

# Vórtex Pay (opcional): só se você for vender Créditos de IA ou o plano do CRM para outras empresas.
# Endereço da sua Vórtex Pay (ex.: https://pay.seu-dominio.com.br).
VORTEXPAY_URL=
# Chave da API de integração da sua Vórtex Pay.
VORTEXPAY_API_KEY=
# "Secret HMAC" do webhook que você cria na Vórtex Pay apontando para a função creditos-webhook.
VORTEXPAY_WEBHOOK_SECRET=

# Vórtex Call (opcional): endereço padrão para a habilidade "Agendar no Vórtex Call" dos agentes de IA.
VORTEX_CALL_URL=

# Funil no Kanban (opcional): só links deste domínio contam como isca (ex.: iscas.seu-dominio.com.br).
ISCAS_DOMINIO=
